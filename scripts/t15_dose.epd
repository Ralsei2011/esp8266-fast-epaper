# t15_dose.epd —— 剂量-反应：横条宽度 / 行数 / 方向
# draw=1 全宽6行 | draw=4 半宽6行 | draw=8 全宽1行 | draw=16 竖直条(全高6宽)
ver

# L1) 全宽 6 行横条（已知会挂）
wash 2
anim 4 1 200 0 0 1 0
sleep 1200

# L2) 半宽 6 行（源线从 128 降到 64）
wash 2
anim 4 1 200 0 0 4 0
sleep 1200

# L3) 全宽 1 行（像素量 1/6）
wash 2
anim 4 1 200 0 0 8 0
sleep 1200

# L4) 竖直条（6 宽、全高），方向反转
wash 2
anim 4 1 200 0 0 16 0
sleep 1200

wash 2
