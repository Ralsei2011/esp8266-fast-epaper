# t11_oldram.epd —— 验证「0x26 旧帧没更新」是不是掉电主因
# 第 7 个参数 both=1 表示每次刷新后把本帧写进 0x26

ver
bb

# F1) 竖条，不维护 0x26（已知会挂）
wash 2
anim 4 1 200 0 0 1 0
sleep 1200
bb

# F2) 竖条，维护 0x26
wash 2
anim 4 1 200 0 0 1 1
sleep 1200
bb

# F3) 竖条+圆，维护 0x26（原来必挂的组合）
wash 2
anim 4 1 200 0 0 3 1
sleep 1200
bb

# F4) 竖条+圆，维护 0x26，长跑 400 帧
wash 2
anim 4 1 200 0 0 3 1
anim 4 1 200 0 200 3 1
sleep 1200
bb

wash 2
