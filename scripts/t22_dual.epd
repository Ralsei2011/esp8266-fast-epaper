# t22_dual.epd —— VS 字节 vs 双向驱动能力
# 0x10=单向(只有+)，0x18=双向(-和+)，0x08=反向单向
ver

# === 单向基线 VS=10 TP1 ===
wash 2
lut vs 10 1
anim -1 0 120 0 0 4 1

# === 双向 VS=18 TP1 ===
wash 2
lut vs 18 1
anim -1 0 120 0 0 4 1

# === 双向 VS=18 TP2 ===
wash 2
lut vs 18 2
anim -1 0 120 0 0 4 1

# === 两相 10(+1) 18(+1) ===
wash 2
lut vs 10 1 18 1
anim -1 0 120 0 0 4 1

# === 两相 18 08 ===
wash 2
lut vs 18 1 08 1
anim -1 0 120 0 0 4 1

wash 2
