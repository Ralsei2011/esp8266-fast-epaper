# t07_why.epd —— 定位「隔一段时间就复位」的真实原因
#
# 判读方法：
#   RTC 存活(非掉电) → 不是电源掉电，是 RST 脚/看门狗/软件复位
#   RTC 已丢失(真掉电) → VCC 真的跌破阈值

ver
bb
wash 2

# ---------- A) 正常动画，一直跑到复位为止 ----------
lut wave 4 1
gate 0 0
mux 296
cp
anim 4 1 200 0 0
sleep 3000
bb

# ---------- B) 全屏黑白交替：每帧翻转全部像素 ----------
wash 2
blink 40 0
sleep 3000
bb

# ---------- C) 纯上传，不驱动面板 ----------
wash 2
blink 0 0
sleep 1000
bb
